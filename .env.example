# Copy this file to .env.local and fill in your Supabase project values.
# Get them from https://supabase.com/dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: customize app name + tagline (used for window title, login screen,
# lists screen header). Defaults to "Lists" / "Shared lists for the household".
# NEXT_PUBLIC_APP_NAME=My Lists
# NEXT_PUBLIC_APP_TAGLINE=Family shared shopping
